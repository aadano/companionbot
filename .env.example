# Teto Companion — API Keys
# Copy this file to .env for local development.
# In a packaged build, set keys via the in-app Settings panel (⚙).
# The Settings panel writes to %APPDATA%\teto-companion\teto-config.json
# and takes precedence over this file.

ANTHROPIC_API_KEY=        # Required — chat + screen reactions (Claude)
OPENAI_API_KEY=           # Required — voice input (Whisper)
FISH_API_KEY=             # Required — voice synthesis (Fish Audio)
FISH_REFERENCE_ID=        # Optional — Fish Audio voice model ID
GEMINI_API_KEY=           # Optional — fallback screen reactions (Gemini)
